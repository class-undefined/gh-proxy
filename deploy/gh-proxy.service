[Unit]
Description=Policy-controlled Git access gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gh-proxy
Group=gh-proxy
WorkingDirectory=/etc/gh-proxy
EnvironmentFile=/etc/gh-proxy/proxy.env
ExecStartPre=/usr/local/bin/gh-proxy --config /etc/gh-proxy/config.toml --check
ExecStart=/usr/local/bin/gh-proxy --config /etc/gh-proxy/config.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
